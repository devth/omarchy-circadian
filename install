#!/bin/sh
set -eu
src=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bin=${XDG_BIN_HOME:-"$HOME/.local/bin"}
units=${XDG_CONFIG_HOME:-"$HOME/.config"}/systemd/user
mkdir -p "$bin" "$units"
make -C "$src" circadian
install -m 755 "$src/circadian" "$bin/circadian"
# systemd paths in ExecStart must be quoted, not interpreted by a shell.
escaped=$(printf '%s' "$bin/circadian" | sed 's/\\/\\\\/g; s/"/\\"/g; s/%/%%/g')
printf '[Unit]\nDescription=Apply Omarchy solar theme\nAfter=graphical-session.target\n\n[Service]\nType=oneshot\nExecStart="%s" check\n' "$escaped" > "$units/omarchy-circadian.service"
printf '[Unit]\nDescription=Check Omarchy solar theme\n\n[Timer]\nOnStartupSec=1min\nOnUnitActiveSec=5min\nAccuracySec=30s\n\n[Install]\nWantedBy=timers.target\n' > "$units/omarchy-circadian.timer"
systemctl --user daemon-reload
systemctl --user enable --now omarchy-circadian.timer
printf 'Installed. Set location with circadian location auto, search, or coords.\n'
