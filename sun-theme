#!/usr/bin/env python3
"""Switch Omarchy theme pairs based on local solar elevation; stdlib only."""
import argparse
import datetime as dt
import fcntl
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import urllib.parse
import urllib.request

CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'omarchy-sun-theme' / 'config.json'
STATE = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp')) / ('omarchy-sun-theme-' + str(os.getuid()) + '.lock')
DEFAULTS = {'location': None, 'selected': 'catppuccin', 'pairs': {'catppuccin': {'light': 'catppuccin-latte', 'dark': 'catppuccin'}, 'solarized': {'light': 'solarized-light', 'dark': 'solarized'}}}

def load():
    if not CONFIG.exists():
        return json.loads(json.dumps(DEFAULTS))
    return json.loads(CONFIG.read_text())

def save(config):
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG.with_suffix('.tmp')
    tmp.write_text(json.dumps(config, indent=2) + '\n')
    os.replace(tmp, CONFIG)

def request(url):
    req = urllib.request.Request(url, headers={'User-Agent': 'omarchy-sun-theme/1.0 (personal desktop theme scheduler)'})
    with urllib.request.urlopen(req, timeout=10) as response:
        return json.load(response)

def coordinates(lat, lon, label):
    lat, lon = float(lat), float(lon)
    if not (-90 <= lat <= 90 and -180 <= lon <= 180):
        raise ValueError('coordinates must be within latitude ±90 and longitude ±180')
    return {'latitude': lat, 'longitude': lon, 'label': label}

def is_day(now, latitude, longitude):
    # NOAA solar position approximation, with standard 0.833° horizon correction.
    now = now.astimezone(dt.timezone.utc)
    n = now.timetuple().tm_yday
    hour = now.hour + now.minute / 60 + now.second / 3600
    gamma = 2 * math.pi / (366 if __import__('calendar').isleap(now.year) else 365) * (n - 1 + (hour - 12) / 24)
    eq = 229.18 * (0.000075 + 0.001868*math.cos(gamma) - 0.032077*math.sin(gamma) - 0.014615*math.cos(2*gamma) - 0.040849*math.sin(2*gamma))
    decl = (0.006918 - 0.399912*math.cos(gamma) + 0.070257*math.sin(gamma) - 0.006758*math.cos(2*gamma) + 0.000907*math.sin(2*gamma) - 0.002697*math.cos(3*gamma) + 0.00148*math.sin(3*gamma))
    angle = math.radians(((hour * 60 + eq + 4 * longitude) % 1440) / 4 - 180)
    lat = math.radians(latitude)
    elevation_sine = math.sin(lat)*math.sin(decl) + math.cos(lat)*math.cos(decl)*math.cos(angle)
    return elevation_sine >= math.sin(math.radians(-0.833))

def apply(config):
    loc = config.get('location')
    if not loc:
        raise ValueError('location not set; run sun-theme location auto, search, or coords')
    pair = config['pairs'][config['selected']]
    day = is_day(dt.datetime.now(dt.timezone.utc), loc['latitude'], loc['longitude'])
    target = pair['light' if day else 'dark']
    result = subprocess.run(['omarchy', 'theme', 'current'], capture_output=True, text=True, check=True)
    normalize = lambda s: s.strip().lower().replace(' ', '-')
    if normalize(result.stdout) != normalize(target):
        subprocess.run(['omarchy', 'theme', 'set', target], check=True)
        print('Applied', target)
    else:
        print(target, 'already active')

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('check')
    sub.add_parser('status')
    sub.add_parser('list')
    sub.add_parser('next')
    select = sub.add_parser('select'); select.add_argument('pair')
    pair = sub.add_parser('pair'); pair.add_argument('name'); pair.add_argument('light'); pair.add_argument('dark')
    location = sub.add_parser('location'); ls = location.add_subparsers(dest='method', required=True)
    ls.add_parser('auto')
    search = ls.add_parser('search'); search.add_argument('query', nargs='+')
    coords = ls.add_parser('coords'); coords.add_argument('latitude', type=float); coords.add_argument('longitude', type=float)
    args = parser.parse_args(); config = load()
    if args.command == 'location':
        if args.method == 'auto':
            data = request('https://ipapi.co/json/')
            if data.get('error'): raise ValueError(str(data.get('reason', 'IP location lookup failed')))
            loc = coordinates(data['latitude'], data['longitude'], ', '.join(filter(None, [data.get('city'), data.get('region'), data.get('country_name')])))
        elif args.method == 'search':
            query = ' '.join(args.query)
            data = request('https://nominatim.openstreetmap.org/search?' + urllib.parse.urlencode({'q': query, 'format': 'jsonv2', 'limit': 5}))
            if not data: raise ValueError('no location matches; try adding a country')
            if len(data) > 1:
                print('Multiple matches; be more specific or use coordinates:', file=sys.stderr)
                for item in data: print(' ', item['display_name'], item['lat'], item['lon'], file=sys.stderr)
                return 1
            loc = coordinates(data[0]['lat'], data[0]['lon'], data[0]['display_name'])
        else: loc = coordinates(args.latitude, args.longitude, 'manual coordinates')
        config['location'] = loc; save(config); print('Location:', loc['label'], loc['latitude'], loc['longitude'])
    elif args.command == 'list':
        for name, p in config['pairs'].items(): print(('*' if name == config['selected'] else ' '), name, ':', p['light'], '/', p['dark'])
    elif args.command == 'status':
        print(json.dumps({'selected': config['selected'], 'pair': config['pairs'][config['selected']], 'location': config['location']}, indent=2))
    elif args.command == 'pair':
        config['pairs'][args.name] = {'light': args.light, 'dark': args.dark}; save(config); print('Saved pair', args.name)
    elif args.command in ('select', 'next'):
        names = list(config['pairs'])
        name = args.pair if args.command == 'select' else names[(names.index(config['selected']) + 1) % len(names)]
        if name not in names: raise ValueError('unknown pair: ' + name)
        config['selected'] = name; save(config); print('Selected', name)
        with STATE.open('w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX); apply(config)
    else:
        with STATE.open('w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX); apply(load())
    return 0

if __name__ == '__main__':
    try: sys.exit(main())
    except (ValueError, KeyError, OSError, subprocess.CalledProcessError) as exc:
        print('sun-theme:', exc, file=sys.stderr); sys.exit(1)
